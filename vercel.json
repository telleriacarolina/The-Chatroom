{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "packages/web",
      "framework": "nextjs",
      "installCommand": "cd ../.. && npm install",
      "buildCommand": "cd ../.. && npm run build:web"
    },
    "api": {
      "root": "packages/api",
      "framework": "express",
      "entrypoint": "src/server.js",
      "installCommand": "cd ../.. && npm install",
      "buildCommand": "cd ../.. && npm run build -w @chatroom/api"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/socket.io",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/socket.io/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/internal/maintenance",
      "schedule": "*/5 * * * *"
    }
  ]
}
