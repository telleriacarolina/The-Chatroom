{
  "version": 2,
  "buildCommand": "npm run build:web",
  "devCommand": "npm run dev -w @chatroom/web",
  "installCommand": "npm install",
  "framework": "nextjs",
  "outputDirectory": "packages/web/.next",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://$API_INTERNAL_URL/api/:path*"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "https://$SOCKET_INTERNAL_URL/socket.io/:path*"
    }
  ]
}
