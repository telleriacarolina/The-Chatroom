DATABASE_URL=postgresql://user:password@localhost:5432/chatroom
JWT_ACCESS_SECRET=your-super-secret-access-key-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-chars
ENCRYPTION_KEY=your-32-byte-hex-key
PHONE_ENC_KEY=your-32-byte-hex-key
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# AWS S3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
S3_BUCKET_NAME=your-verification-bucket

# Verification
VERIFICATION_RETENTION_DAYS=90
MAX_VERIFICATION_ATTEMPTS=3
# Database
DATABASE_URL=postgresql://user:password@localhost:5432/the_chatroom

# JWT secrets
ACCESS_TOKEN_SECRET=replace_with_strong_access_secret
REFRESH_TOKEN_SECRET=replace_with_strong_refresh_secret

# Socket relay config
# Set API_INTERNAL_URL and SOCKET_INTERNAL_URL to full origins for Vercel deployments, e.g.
# API_INTERNAL_URL=https://api.example.com
# SOCKET_INTERNAL_URL=https://socket.example.com
# Also set NEXT_PUBLIC_API_URL and NEXT_PUBLIC_SOCKET_URL to the public preview/prod origins that the browser should use.

# Twilio
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_NUMBER=+1234567890
